---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const stickerClasses = [
  '-top-4 left-[6%] -rotate-6',
  'top-10 right-[5%] rotate-3 bg-orange',
  'bottom-7 left-[10%] rotate-2 bg-sea',
];
---

<section id="top" data-hero class="overflow-hidden pt-32 lg:pt-40" aria-labelledby="hero-title">
  <div class="container-x">
    <p class="mono mb-5 text-orange">{t.hero.label}</p>
    <h1 id="hero-title" class="display text-[clamp(2.75rem,12vw,15rem)] leading-[0.82]">
      <span class="block">
        <span class="inline-block overflow-hidden align-top">
          <span data-line class="ghost inline-block text-bone">{t.hero.title.ghost}</span>
        </span>
        {' '}
        <span class="inline-block overflow-hidden align-top">
          <span data-line class="inline-block">{t.hero.title.line1}</span>
        </span>
      </span>
      <span class="block">
        <span class="inline-block overflow-hidden align-top">
          <span data-line class="inline-block">
            {t.hero.title.line2}<span class="text-orange">.</span>
          </span>
        </span>
      </span>
    </h1>

    <ul class="mono mt-7 flex flex-wrap gap-x-8 gap-y-2 text-muted-light">
      {
        t.hero.subLines.map((line, index) => (
          <li data-fade>
            {String(index + 1).padStart(2, '0')} — {line}
          </li>
        ))
      }
    </ul>

    <div data-hero-pic class="relative mt-10">
      <!-- Portrait photo in a 4/5 box on phones, the landscape sunset in a 3/2 box from md. -->
      <div class="aspect-[4/5] overflow-hidden md:aspect-[3/2] md:max-h-[68vh]">
        <picture>
          <source
            media="(max-width: 767px)"
            srcset={t.hero.image.mobile.srcset}
            sizes={t.hero.image.mobile.sizes}
            width={t.hero.image.mobile.width}
            height={t.hero.image.mobile.height}
          />
          <img
            data-hero-img
            data-asset-slot="hero"
            src={t.hero.image.desktop.src}
            srcset={t.hero.image.desktop.srcset}
            sizes={t.hero.image.desktop.sizes}
            alt={t.hero.image.desktop.alt}
            width={t.hero.image.desktop.width}
            height={t.hero.image.desktop.height}
            loading="eager"
            fetchpriority="high"
            class="relative top-[-7.5%] block h-[115%] w-full object-cover"
          />
        </picture>
      </div>
      {
        t.hero.stickers.map((text, index) => (
          <span data-sticker class:list={['tag', stickerClasses[index]]} aria-hidden="true">
            {text}
          </span>
        ))
      }
    </div>
  </div>
</section>
