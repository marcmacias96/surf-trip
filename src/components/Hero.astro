---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const stickerClasses = [
  '-top-4 left-[6%] -rotate-6 lg:top-8 lg:left-[40%]',
  'top-10 right-[5%] rotate-3 bg-orange',
  'bottom-7 left-[10%] rotate-2 bg-sea',
];
---

<section id="top" data-hero class="overflow-hidden pt-32 lg:pt-40" aria-labelledby="hero-title">
  <div class="container-x">
    <p class="mono mb-5 text-orange">{t.hero.label}</p>
    <h1 id="hero-title" class="display relative z-10 text-[clamp(2.75rem,9vw,9rem)] leading-[0.82]">
      <span class="block">
        <span class="inline-block overflow-hidden align-top">
          <span data-line class="ghost inline-block text-bone">{t.hero.title.ghost}</span>
        </span>
        {' '}
        <span class="inline-block overflow-hidden align-top">
          <span data-line class="inline-block">{t.hero.title.line1}</span>
        </span>
      </span>
      <span class="block">
        <span class="inline-block overflow-hidden align-top">
          <span data-line class="inline-block">
            {t.hero.title.line2}<span class="text-orange">.</span>
          </span>
        </span>
      </span>
    </h1>

    <div class="lg:-mt-28 lg:grid lg:grid-cols-12 lg:gap-x-8">
    <div class="relative z-10 lg:col-span-2 lg:self-end lg:pb-8">
    <ul class="mono mt-7 flex flex-wrap gap-x-8 gap-y-2 text-muted-light lg:mt-0 lg:flex-col lg:gap-y-3">
      {
        t.hero.subLines.map((line, index) => (
          <li data-fade>
            {String(index + 1).padStart(2, '0')} — {line}
          </li>
        ))
      }
    </ul>
    <div class="mt-7 flex flex-wrap items-center gap-x-8 gap-y-3 lg:mt-8 lg:flex-col lg:items-start">
      <a href={getRelativeLocaleUrl(lang, 'book')} class="btn whitespace-nowrap px-7 py-4 text-base lg:px-5 lg:text-sm xl:px-7 xl:text-base">{t.hero.book}</a>
      <a href="#route" class="link-underline">{t.hero.seeRoute}</a>
    </div>
    </div>

    <div data-hero-pic class="relative mt-10 lg:col-span-10 lg:mt-0">
      <!-- Portrait photo in a 4/5 box on phones, the landscape sunset in a 3/2 box from md. -->
      <div class="relative aspect-[4/5] overflow-hidden md:aspect-[3/2] md:max-h-[68vh]">
        <picture>
          <source
            media="(max-width: 767px)"
            srcset={t.hero.image.mobile.srcset}
            sizes={t.hero.image.mobile.sizes}
            width={t.hero.image.mobile.width}
            height={t.hero.image.mobile.height}
          />
          <img
            data-hero-img
            data-asset-slot="hero"
            src={t.hero.image.desktop.src}
            srcset={t.hero.image.desktop.srcset}
            sizes={t.hero.image.desktop.sizes}
            alt={t.hero.image.desktop.alt}
            width={t.hero.image.desktop.width}
            height={t.hero.image.desktop.height}
            loading="eager"
            fetchpriority="high"
            class="relative top-[-7.5%] block h-[115%] w-full object-cover"
          />
        </picture>
        <!-- On desktop the photo rises behind the headline, so it fades out of the page colour at its top-left. -->
        <div class="pointer-events-none absolute inset-0 hidden bg-gradient-to-b from-asphalt/85 via-asphalt/10 to-transparent lg:block" aria-hidden="true"></div>
        <div class="pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-asphalt/70 via-transparent to-transparent lg:block" aria-hidden="true"></div>
      </div>
      {
        t.hero.stickers.map((text, index) => (
          <span data-sticker class:list={['tag', stickerClasses[index]]} aria-hidden="true">
            {text}
          </span>
        ))
      }
    </div>
    </div>
  </div>
</section>
