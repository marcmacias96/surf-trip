---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const slots = ['experience-custom', 'experience-group'];
---

<section id="experiences" class="border-t-4 border-bone" aria-labelledby="transport-title">
  <div class="grid lg:grid-cols-2">
    <picture class="relative block">
      <source
        media="(max-width: 767px)"
        srcset={t.transport.image.mobile.srcset}
        sizes={t.transport.image.mobile.sizes}
        width={t.transport.image.mobile.width}
        height={t.transport.image.mobile.height}
      />
      <img
        data-asset-slot="transport"
        src={t.transport.image.desktop.src}
        srcset={t.transport.image.desktop.srcset}
        sizes={t.transport.image.desktop.sizes}
        alt={t.transport.image.desktop.alt}
        width={t.transport.image.desktop.width}
        height={t.transport.image.desktop.height}
        loading="lazy"
        decoding="async"
        class="block aspect-[4/5] w-full object-cover md:aspect-[3/2] lg:absolute lg:inset-0 lg:aspect-auto lg:h-full"
      />
    </picture>
    <div class="bg-bone px-[clamp(24px,4vw,64px)] py-16 text-asphalt lg:py-20">
      <p class="mono">{t.transport.label}</p>
      <h2
        id="transport-title"
        class="display mt-4 text-[clamp(2.4rem,5vw,4.6rem)] leading-[0.9] tracking-[-0.03em]"
      >
        {t.transport.lines[0]}<br />{t.transport.lines[1]}
      </h2>
      <ul class="mt-8 grid gap-3.5">
        {
          t.transport.bullets.map((bullet) => (
            <li data-fade class="flex items-baseline gap-3.5">
              <span class="h-1 w-7 shrink-0 -translate-y-1 bg-orange" aria-hidden="true" />
              <span>{bullet}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-9"><a href="#contact" class="btn">{t.transport.cta}</a></p>
    </div>
  </div>

  <div class="container-x section-y">
    <p class="mono text-orange">{t.experiences.label}</p>
    <h3 class="display mt-5 text-[clamp(2.4rem,5.5vw,5rem)]">{t.experiences.title}</h3>
    <p class="mono mt-4 text-muted">{t.experiences.capacity}</p>

    <div class="mt-12 grid border-t border-line md:grid-cols-2">
      {
        t.experiences.modalities.map((modality, index) => (
          <article
            data-fade
            class="border-b border-line py-8 md:first:border-r md:first:pr-8 md:last:pl-8"
          >
            <img
              data-asset-slot={slots[index]}
              src={modality.image.src}
              srcset={modality.image.srcset}
              sizes={modality.image.sizes}
              alt={modality.image.alt}
              width={modality.image.width}
              height={modality.image.height}
              loading="lazy"
              decoding="async"
              class="aspect-[3/2] w-full object-cover"
            />
            <p class="mono mt-6 text-orange">{String(index + 1).padStart(2, '0')}</p>
            <h4 class="display mt-2 text-2xl md:text-3xl">{modality.title}</h4>
            <p class="mt-3 text-muted-light">{modality.description}</p>
          </article>
        ))
      }
    </div>

    <h3 class="mono mt-16 text-orange">{t.experiences.includedTitle}</h3>
    <ol class="mt-4 grid gap-x-12 md:grid-cols-2">
      {
        t.experiences.included.map((item, index) => (
          <li data-fade class="flex items-baseline gap-4 border-b border-line py-3.5">
            <span class="mono w-6 shrink-0 text-orange">{String(index + 1).padStart(2, '0')}</span>
            <span class="font-medium">{item}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
