---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const links = [
  { href: '#route', label: t.nav.route },
  { href: '#experiences', label: t.nav.experiences },
  { href: '#partners', label: t.nav.partners },
  { href: '#pilot', label: t.nav.pilot },
  { href: '#contact', label: t.nav.contact },
];
---

<a href="#main" class="skip-link">{t.nav.skip}</a>

<header data-nav class="nav fixed inset-x-0 top-0 z-50 border-b border-line text-bone">
  <nav
    class="container-x flex min-h-16 items-center justify-between gap-4 pt-[env(safe-area-inset-top)] lg:min-h-20 lg:gap-6"
    aria-label="Main"
  >
    <a
      href="#top"
      class="whitespace-nowrap font-display text-sm font-extrabold uppercase tracking-[-0.02em] lg:text-lg"
    >
      Radical Marino
    </a>

    <ul class="hidden items-center gap-6 lg:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="link-underline">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-4 md:gap-6">
      <ul class="flex items-center gap-4" aria-label={t.nav.switchLabel}>
        {
          (Object.keys(languages) as Lang[]).map((code) => (
            <li>
              <a
                href={getRelativeLocaleUrl(code)}
                aria-current={code === lang ? 'page' : undefined}
                class:list={['link-underline', code === lang ? 'text-bone' : 'text-muted']}
              >
                {languages[code]}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="#contact" class="btn whitespace-nowrap px-4 lg:px-5">
        <span class="lg:hidden">{t.nav.ctaShort}</span>
        <span class="hidden lg:inline">{t.nav.cta}</span>
      </a>
    </div>
  </nav>
</header>
