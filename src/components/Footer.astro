---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="mono border-t border-line py-8 text-muted">
  <div class="container-x flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <p>{t.footer.smallPrint}</p>
    <ul class="flex items-center gap-3" aria-label={t.nav.switchLabel}>
      {
        (Object.keys(languages) as Lang[]).map((code) => (
          <li>
            <a
              href={getRelativeLocaleUrl(code)}
              aria-current={code === lang ? 'page' : undefined}
              class:list={['link-underline', code === lang ? 'text-bone' : 'text-muted']}
            >
              {languages[code]}
            </a>
          </li>
        ))
      }
    </ul>
    <p>{t.footer.hub}</p>
  </div>
</footer>
