---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const words = t.manifesto.text.split(' ');
---

<section id="manifesto" class="section-y" aria-labelledby="manifesto-title">
  <div class="container-x">
    <p class="mono text-orange">{t.manifesto.label}</p>
    <h2
      id="manifesto-title"
      data-fade
      class="display mt-5 max-w-[14ch] text-[clamp(2.4rem,5.5vw,5rem)] leading-[0.9] tracking-[-0.03em]"
    >
      {t.manifesto.title.solid} <span class="text-sea">{t.manifesto.title.accent}</span>
    </h2>
    <p
      data-manifesto
      class="mt-12 max-w-5xl text-[clamp(1.3rem,2.4vw,2rem)] font-medium leading-[1.3]"
    >
      {words.map((word) => <span data-word>{`${word} `}</span>)}
    </p>
  </div>
</section>
