---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="pilot" data-pilot class="section-y border-t border-line" aria-labelledby="pilot-title">
  <div class="container-x">
    <p class="mono text-orange">{t.pilot.label}</p>
    <h2 id="pilot-title" data-fade class="display mt-5 text-[clamp(2.4rem,5.5vw,5rem)]">
      {t.pilot.title}
    </h2>

    <div class="relative mt-12">
      <div
        data-pilot-line
        class="absolute left-0 top-0 h-full w-px bg-orange lg:h-px lg:w-full"
        aria-hidden="true"
      >
      </div>
      <ol class="grid border-l border-line lg:grid-cols-4 lg:border-l-0 lg:border-t">
        {
          t.pilot.steps.map((step, index) => (
            <li class="relative border-b border-line py-6 pl-8 lg:border-b-0 lg:border-r lg:px-5 lg:pb-10 lg:pt-8 lg:nth-[4n]:border-r-0 lg:nth-[n+5]:border-t">
              <span
                data-pilot-dot
                class="absolute left-[-4px] top-7 block h-[9px] w-[9px] bg-orange lg:left-5 lg:top-[-4px]"
                aria-hidden="true"
              />
              <span class="mono text-muted">{String(index + 1).padStart(2, '0')}</span>
              <p class="mt-2 font-medium">{step}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mt-20 grid gap-6 border-t border-line pt-10 md:grid-cols-[1fr_2fr]">
      <h3 class="mono text-orange">{t.pilot.visionTitle}</h3>
      <p data-fade class="max-w-3xl text-[clamp(1.25rem,2.4vw,2rem)] font-medium leading-[1.3]">
        {t.pilot.vision}
      </p>
    </div>
  </div>
</section>
