---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cell = 'border-b border-dashed border-dash py-5';
const showLabel = (name: string) =>
  lang === 'es' ? `Mostrar ${name} en el collage` : `Show ${name} in the collage`;

// Hand-tuned collage slots (centre x, centre y, tilt). Later prints sit nearer the centre and on top.
const slots = [
  { x: '36%', y: '30%', r: '-7deg' },
  { x: '64%', y: '34%', r: '6deg' },
  { x: '40%', y: '62%', r: '3deg' },
  { x: '63%', y: '66%', r: '-9deg' },
  { x: '44%', y: '44%', r: '8deg' },
  { x: '55%', y: '52%', r: '-3deg' },
];
---

<section id="route" data-route class="section-y border-t border-line" aria-labelledby="route-title">
  <div class="container-x">
    <p class="mono text-orange">{t.route.label}</p>
    <h2 id="route-title" data-fade class="display mt-5 text-[clamp(2.4rem,5.5vw,5rem)]">
      {t.route.title}
    </h2>

    <div class="mt-12 lg:grid lg:grid-cols-[3fr_2fr] lg:items-start lg:gap-12">
      <div id="route-board" data-route-board class="route-board lg:col-start-2 lg:row-start-1">
        <div data-route-pile class="absolute inset-0">
          {
            t.route.stops.map((stop, index) => (
              <div
                class="route-slot"
                style={`--x:${slots[index].x};--y:${slots[index].y};--r:${slots[index].r}`}
              >
                <figure data-print={index} class="route-print">
                  <img
                    data-asset-slot={`route-${stop.id}`}
                    src={stop.image.src}
                    srcset={stop.image.srcset}
                    sizes={stop.image.sizes}
                    alt={stop.image.alt}
                    width={stop.image.width}
                    height={stop.image.height}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[5/4] w-full object-cover"
                  />
                  <figcaption class="route-print-caption">
                    {String(index + 1).padStart(2, '0')} · {stop.name}
                  </figcaption>
                </figure>
              </div>
            ))
          }
        </div>
      </div>

      <div class="relative pl-6 md:pl-8 lg:col-start-1 lg:row-start-1">
        <div
          data-route-line
          class="absolute inset-y-0 left-0 border-l border-dashed border-muted"
          aria-hidden="true"
        >
        </div>

        <div data-route-table role="table" class="mono w-full">
          <div role="row" class="grid grid-cols-[3.5rem_1fr_auto] md:grid-cols-[4rem_1.4fr_1fr_auto]">
            <span role="columnheader" class={`${cell} py-0 pb-3 text-muted`}>{t.route.headers.index}</span>
            <span role="columnheader" class={`${cell} py-0 pb-3 text-muted`}>{t.route.headers.stop}</span>
            <span role="columnheader" class={`${cell} hidden py-0 pb-3 text-muted md:block`}>
              {t.route.headers.info}
            </span>
            <span role="columnheader" class={`${cell} py-0 pb-3 text-right text-muted`}>
              {t.route.headers.distance}
            </span>
          </div>
          {
            t.route.stops.map((stop, index) => (
              <div
                role="row"
                data-stop={stop.id}
                data-fade
                class="relative grid grid-cols-[3.5rem_1fr_auto] items-center md:grid-cols-[4rem_1.4fr_1fr_auto]"
              >
                <span role="cell" class={`${cell} font-bold text-orange`}>
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span
                  role="cell"
                  class={`${cell} display text-[clamp(1.4rem,2.6vw,2.4rem)] tracking-[-0.02em]`}
                >
                  <button
                    type="button"
                    data-stop-button
                    class="route-stop-btn"
                    aria-controls="route-board"
                    aria-label={showLabel(stop.name)}
                  >
                    {stop.name}
                  </button>
                </span>
                <span role="cell" class={`${cell} hidden pr-6 text-muted-light md:block`}>
                  {stop.info}
                </span>
                <span role="cell" class={`${cell} whitespace-nowrap text-right`}>
                  {stop.distance}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
