---
import type { Lang } from '../i18n/ui';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Marquee from './Marquee.astro';
import Stats from './Stats.astro';
import Manifesto from './Manifesto.astro';
import Route from './Route.astro';
import Experiences from './Experiences.astro';
import TruckConfigurator from './TruckConfigurator.astro';
import Partners from './Partners.astro';
import Pilot from './Pilot.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import BookBar from './BookBar.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Nav lang={lang} />
<main id="main">
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <Stats lang={lang} />
  <Manifesto lang={lang} />
  <Route lang={lang} />
  <Experiences lang={lang} />
  <TruckConfigurator lang={lang} />
  <Partners lang={lang} />
  <Pilot lang={lang} />
  <Contact lang={lang} />
</main>
<Footer lang={lang} />
<BookBar lang={lang} />
