---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// TODO(content): replace with the real Radical Marino contact address.
const email = 'hello@radicalmarino.com';
---

<section id="contact" data-contact class="section-y border-t border-line" aria-labelledby="contact-title">
  <div class="container-x">
    <p class="mono text-orange">{t.contact.label}</p>
    <h2 id="contact-title" class="display mt-5 text-[clamp(2.75rem,11vw,10rem)] leading-[0.85]">
      <span class="block overflow-hidden">
        <span data-line class="block">{t.contact.title.solid}</span>
      </span>
      <span class="block overflow-hidden">
        <span data-line class="ghost block text-bone">{t.contact.title.ghost}</span>
      </span>
    </h2>
    <p data-fade class="mt-10 max-w-xl text-lg text-muted-light">{t.contact.text}</p>
    <div data-fade class="mt-10 flex flex-wrap items-center gap-8">
      <a href={`mailto:${email}`} class="btn">{t.contact.cta}</a>
      <a href="#top" class="link-underline">{t.contact.secondary}</a>
    </div>
  </div>
</section>
